# syntax=docker/dockerfile:1
#
# just-makeit example sandbox — Linux (Debian/GCC)
#
# Build from repo root:
#   docker build -f docker/Dockerfile.examples-linux -t jm-examples-linux .
#
# Run:
#   docker run -it --rm jm-examples-linux

FROM python:3.12-slim-trixie

ENV JM_HOME=/home/just-makeit

# ── Named sandbox user + fixed prompt ────────────────────────────────────────
# `USER 1000:1000` (a bare numeric UID with no /etc/passwd entry) makes bash
# render "I have no name!@<container-id>". Create a real `user` so the shell
# has an identity, and install a fixed `user@jm-sandbox:<cwd>$` prompt for both
# shell kinds: /etc/profile.d covers the login-shell CMD (sourced after
# /etc/bash.bashrc, so it wins), and appending to /etc/skel/.bashrc *before*
# useradd — so the new user's ~/.bashrc carries it — covers a nested,
# non-login `bash`. Independent of repo source, so this layer stays cached.
COPY docker/prompt.sh /etc/profile.d/05-jm-prompt.sh
RUN cat /etc/profile.d/05-jm-prompt.sh >> /etc/skel/.bashrc && \
    useradd --uid 1000 --create-home --home-dir ${JM_HOME} \
        --shell /bin/bash user && \
    chmod +x /etc/profile.d/05-jm-prompt.sh

# ── Install pip + build-time Python deps (independent of repo source) ────────
# numpy must be globally reachable so cmake's find_package(Python3 ... NumPy)
# succeeds when cmake is invoked with -DPython3_EXECUTABLE=$(which python3).
# pytest/cmakelang are needed later to build+test the bundled examples. None
# of these three depend on repo content, so this layer stays CACHED across
# every rebuild unless the base image or these pins change.
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir numpy pytest cmakelang

# ── Install just-makeit from local source ────────────────────────────────────
# Installing from source (not PyPI) ensures the image always reflects the
# current HEAD — no version lag. `pip install .` only needs pyproject.toml,
# README.md, and src/ (package data, incl. src/just_makeit/examples/) — so
# editing tests/, docs/, the Makefile, CHANGELOG.md, etc. no longer
# invalidates this layer.
COPY pyproject.toml README.md /src/
COPY src/ /src/src/
RUN python -m pip install --no-cache-dir /src

# ── Install build deps (cmake, gcc, pkg-config) ───────────────────────────────
# Requires the just-makeit CLI on PATH (installed above), so this stays
# sequenced after the /src install — its own work (apt installs + a
# separate /tmp/jm-venv pulling numpy/just-makeit from PyPI) never reads
# /src, but invoking it via the CLI ties its cache to /src's cache.
#
# (No C++ stdlib needed: doppler >= 0.14.0 ships doppler::doppler-static
# C++-free — C99 pocketfft, ZMQ/stream split into the optional doppler::stream
# targets — so the examples link it with `-lm` alone. The pin lives in
# examples/nco_tone/test.py.)
RUN just-makeit install-deps

# ── Scaffold, build, and test all bundled examples ────────────────────────────
# This is the expensive layer — twenty-odd projects scaffolded, compiled and
# tested. It records WHAT it built to $JM_HOME/.jm-built.json and renders no
# prose; the page itself is written by the step below, from that manifest.
#
# The split is for separability, not build caching: `welcome.py` is copied
# here because build_examples imports `describe` from it, so editing it does
# still invalidate this layer. What it buys is a pure renderer a test can
# drive with any mapping, and a page that can be regenerated inside a running
# container without rebuilding anything.
RUN mkdir -p ${JM_HOME}/examples
COPY docker/build_examples.py docker/welcome.py /tmp/
RUN python3 /tmp/build_examples.py ${JM_HOME}/examples

# ── The welcome page, from what the step above observed ──────────────────────
RUN python3 /tmp/welcome.py ${JM_HOME} && \
    test -s ${JM_HOME}/README.md

# ── Tutorials, somewhere a human can type ────────────────────────────────────
# The per-example walkthroughs are package data, so they sit at a site-packages
# path nobody will retype. The symlink target is DISCOVERED rather than written
# down: it moves with the Python version, and a hardcoded 3.12 would break the
# next base-image bump silently — the link would dangle and `less` would just
# say "No such file".
RUN ln -sfn "$(python3 -c 'import just_makeit, pathlib; print(pathlib.Path(just_makeit.__file__).parent / "examples")')" \
        ${JM_HOME}/tutorials && \
    test -r ${JM_HOME}/tutorials/fir_filter/README.md

# ── Welcome message ──────────────────────────────────────────────────────────
# One source, two surfaces: the editor opens $JM_HOME/README.md and this prints
# the same file. JM_HOME is already ENV, so motd.sh resolves it at runtime.
COPY docker/motd.sh /etc/profile.d/00-jm-examples.sh
RUN chmod +x /etc/profile.d/00-jm-examples.sh && \
    chown -R user:user ${JM_HOME}

USER user
WORKDIR ${JM_HOME}/examples
CMD ["/bin/bash", "-l"]
