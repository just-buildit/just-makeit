@PACKAGE_INIT@

# Find the packages this library depends on ([project] find_packages and
# pkg_modules), so their targets exist before ours are loaded.
@JM_FIND_DEPENDENCIES@

# The library targets this package provides.
include("${CMAKE_CURRENT_LIST_DIR}/<<project_underscore>>-targets.cmake")

# Each additional library is a component of the package:
# find_package(<<project_underscore>> REQUIRED COMPONENTS <name>). A component
# is found if its library was built for this platform.
foreach(_jm_comp IN LISTS <<project_underscore>>_FIND_COMPONENTS)
  if(TARGET <<project_underscore>>::${_jm_comp})
    set(<<project_underscore>>_${_jm_comp}_FOUND TRUE)
  else()
    set(<<project_underscore>>_${_jm_comp}_FOUND FALSE)
  endif()
endforeach()

check_required_components(<<project_underscore>>)
