# syntax=docker/dockerfile:1
#
# just-makeit example sandbox — Linux (Debian/GCC)
#
# Build from repo root:
#   docker build -f docker/Dockerfile.examples-linux -t jm-examples-linux .
#
# Run:
#   docker run -it --rm jm-examples-linux

FROM python:3.12-slim-trixie

ENV JM_HOME=/home/just-makeit

# ── Install pip + build-time Python deps (independent of repo source) ────────
# numpy must be globally reachable so cmake's find_package(Python3 ... NumPy)
# succeeds when cmake is invoked with -DPython3_EXECUTABLE=$(which python3).
# pytest/cmakelang are needed later to build+test the bundled examples. None
# of these three depend on repo content, so this layer stays CACHED across
# every rebuild unless the base image or these pins change.
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir numpy pytest cmakelang

# ── Install just-makeit from local source ────────────────────────────────────
# Installing from source (not PyPI) ensures the image always reflects the
# current HEAD — no version lag. `pip install .` only needs pyproject.toml,
# README.md, and src/ (package data, incl. src/just_makeit/examples/) — so
# editing tests/, docs/, the Makefile, CHANGELOG.md, etc. no longer
# invalidates this layer.
COPY pyproject.toml README.md /src/
COPY src/ /src/src/
RUN python -m pip install --no-cache-dir /src

# ── Install build deps (cmake, gcc, pkg-config) ───────────────────────────────
# Requires the just-makeit CLI on PATH (installed above), so this stays
# sequenced after the /src install — its own work (apt installs + a
# separate /tmp/jm-venv pulling numpy/just-makeit from PyPI) never reads
# /src, but invoking it via the CLI ties its cache to /src's cache.
#
# (No C++ stdlib needed: doppler >= 0.14.0 ships doppler::doppler-static
# C++-free — C99 pocketfft, ZMQ/stream split into the optional doppler::stream
# targets — so the examples link it with `-lm` alone. The pin lives in
# examples/nco_tone/test.py.)
RUN just-makeit install-deps

# ── Scaffold, build, and test all bundled examples ────────────────────────────
RUN mkdir -p ${JM_HOME}/examples
COPY docker/build_examples.py /tmp/build_examples.py
RUN python3 /tmp/build_examples.py ${JM_HOME}/examples

# ── Welcome message ──────────────────────────────────────────────────────────
COPY docker/motd.sh /etc/profile.d/00-jm-examples.sh
RUN chmod +x /etc/profile.d/00-jm-examples.sh && \
    chown -R 1000:1000 ${JM_HOME}

USER 1000:1000
WORKDIR ${JM_HOME}/examples
CMD ["/bin/bash", "-l"]
