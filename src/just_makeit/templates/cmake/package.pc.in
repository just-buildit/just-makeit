prefix=@JM_PC_PREFIX@
exec_prefix=${prefix}
libdir=@JM_PC_LIBDIR@
includedir=@JM_PC_INCLUDEDIR@

Name: <<project_underscore>>
Description: @PROJECT_DESCRIPTION@
@JM_PC_EXTRA_FIELDS@Version: @PROJECT_VERSION@
