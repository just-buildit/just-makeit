prefix=@JM_PC_PREFIX@
exec_prefix=${prefix}
libdir=@JM_PC_LIBDIR@
includedir=@JM_PC_INCLUDEDIR@

Name: <<project>>
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -l<<project_underscore>>@JM_PC_LIBM@
Cflags: -I${includedir}@JM_PC_CFLAGS@
@JM_PC_REQUIRES_PRIVATE@
@JM_PC_LIBS_PRIVATE@
