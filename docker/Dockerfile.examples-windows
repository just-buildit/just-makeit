# escape=`
# syntax=docker/dockerfile:1
#
# just-makeit example sandbox — Windows (MinGW/GCC)
#
# Requires a Windows Docker engine (Windows containers mode).
#
# Build from repo root:
#   docker build -f docker/Dockerfile.examples-windows -t jm-examples-windows .
#
# Run:
#   docker run -it --rm jm-examples-windows

FROM python:3.12-windowsservercore-ltsc2022

SHELL ["powershell", "-Command", `
       "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

# ── Install Chocolatey ────────────────────────────────────────────────────────
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; `
    [Net.ServicePointManager]::SecurityProtocol = 'Tls12'; `
    iex ((New-Object Net.WebClient).DownloadString( `
        'https://community.chocolatey.org/install.ps1'))

# ── Install MinGW (gcc + mingw32-make) and cmake via Chocolatey ───────────────
RUN choco install -y mingw cmake --no-progress

# Add MinGW bin alongside the Chocolatey shims already in PATH.
RUN $mingw_lib = 'C:\ProgramData\chocolatey\lib\mingw\tools\install\mingw64\bin'; `
    if (Test-Path $mingw_lib) { `
        $cur = [Environment]::GetEnvironmentVariable('Path', 'Machine'); `
        [Environment]::SetEnvironmentVariable('Path', ($mingw_lib + ';' + $cur), 'Machine'); `
        Write-Host ('Added ' + $mingw_lib + ' to system PATH') `
    } else { `
        Write-Warning 'MinGW bin not found at expected path - shims only' `
    }

# Create make.exe alias so examples that call ["make"] work on Windows.
# choco's mingw installs mingw32-make.exe but not make.exe; search both
# the fixed choco lib path and the actual install location.
RUN $candidates = @( `
        'C:\ProgramData\chocolatey\lib\mingw\tools\install\mingw64\bin', `
        'C:\ProgramData\mingw64\mingw64\bin' `
    ); `
    $bin = $candidates | Where-Object { Test-Path (Join-Path $_ 'mingw32-make.exe') } | Select-Object -First 1; `
    if ($bin) { `
        Copy-Item (Join-Path $bin 'mingw32-make.exe') (Join-Path $bin 'make.exe'); `
        Write-Host ('Created make.exe in ' + $bin) `
    } else { `
        throw 'mingw32-make.exe not found in any candidate path' `
    }

# Verify build tools are reachable before continuing.
RUN gcc --version; mingw32-make --version; make --version; cmake --version

# ── Install numpy, pytest, and just-makeit from local source ─────────────────
# Installing from source ensures the image always reflects the current HEAD.
COPY . C:\src
RUN python -m pip install --no-cache-dir --upgrade pip; `
    pip install --no-cache-dir numpy pytest cmakelang C:\src

# ── Scaffold, build, and test all bundled examples ────────────────────────────
COPY docker/build_examples.py C:\build_examples.py
RUN python C:\build_examples.py C:\Users\ContainerAdministrator\examples

# ── Welcome message ──────────────────────────────────────────────────────────
COPY docker/motd.ps1 C:\motd.ps1

WORKDIR C:\Users\ContainerAdministrator\examples
CMD ["powershell", "-NoExit", "-File", "C:\\motd.ps1"]
