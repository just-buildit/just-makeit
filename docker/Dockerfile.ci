# syntax=docker/dockerfile:1
#
# jm's CI toolchain: the image every Linux `test` and `examples` leg of
# ci.yml runs in, pinned by digest in .github/ci-image.
#
# Every input is pinned, so the same file builds the same image:
#
#   - the base, by digest (FROM below);
#   - every apt package, from one dated snapshot.ubuntu.com snapshot
#     (APT_SNAPSHOT) instead of whatever a live mirror serves that minute;
#   - uv, by digest.
#
# `make ci-image-refresh` moves all three to today's; the weekly
# ci-image.yml runs it, builds and smoke-tests the image, and opens a PR
# that re-pins .github/ci-image. That PR's CI runs ON the new image, so a
# toolchain change lands only through green CI, and reverting one line
# rolls it back.
#
# The packages are not listed here. APT_PACKAGES is bootstrap.toml's
# `dev.apt` group (what a contributor installs with `make install-deps-dev`)
# plus CI_EXTRA_PACKAGES below, and `make ci-image-build` passes it in, so
# the image and a laptop read one declaration.
#
# Build from the repo root: `make ci-image-build`.

FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3 AS certs

# The snapshot is served over https only, and the bare base has no CA
# bundle. This stage fetches one from the live archive, and the final stage
# borrows the bundle for TLS alone: every package in the final image,
# ca-certificates included, still comes from the snapshot.
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update -qq \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 \
        install -y -qq --no-install-recommends ca-certificates

FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

ARG APT_SNAPSHOT=20261001T000000Z
ARG APT_PACKAGES
# What CI needs beyond the dev group: git for actions/checkout (without it
# the action falls back to a tarball, and the suite's release gates read
# tags); clang for the -Werror scaffold sweep, which builds every shape under
# gcc AND clang; jq for changes.yml's fast-path verdict, whose tests run the
# step itself. ubuntu-latest ships all of them, so a missing one shows up
# here as a suite that skips or fails only in the image.
ARG CI_EXTRA_PACKAGES="ca-certificates git clang jq"
# Set by `make ci-image-build`: a hash of this file and APT_PACKAGES, so
# `make ci-image-check` can tell an image built from other inputs.
ARG CI_INPUTS
LABEL org.just-buildit.ci-inputs="${CI_INPUTS}" \
      org.just-buildit.apt-snapshot="${APT_SNAPSHOT}" \
      org.opencontainers.image.source="https://github.com/just-buildit/just-makeit"

COPY --from=certs /etc/ssl/certs/ca-certificates.crt /tmp/snapshot-ca.crt

# One URI for both architectures: the snapshot serves arm64 under /ubuntu/,
# and has no /ubuntu-ports/ (measured 2026-10-01: 401). Each fetch is
# bounded, so a stalled connection becomes an error the retries cover rather
# than a hang (gh-1792).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN test -n "${APT_PACKAGES}" \
    && sed -i -E \
        "s#^URIs: .*#URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}/#" \
        /etc/apt/sources.list.d/ubuntu.sources \
    && O=(-o Acquire::https::CAInfo=/tmp/snapshot-ca.crt \
          -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 \
          -o Acquire::Retries=3 -o Acquire::Check-Valid-Until=false) \
    && apt-get "${O[@]}" update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get "${O[@]}" install -y -qq \
        --no-install-recommends ${APT_PACKAGES} ${CI_EXTRA_PACKAGES} \
    && rm -rf /var/lib/apt/lists/* /tmp/snapshot-ca.crt

COPY --from=ghcr.io/astral-sh/uv@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 \
    /uv /uvx /usr/local/bin/
